# Copy to infra/.env for local development. Never commit infra/.env.
KEMUDI_SCHEME=http
KEMUDI_WS_SCHEME=ws
KEMUDI_DOMAIN=localhost:9100
KEMUDI_PORT=9100
# Stock taiga-front, kept during the move to apps/web.
KEMUDI_LEGACY_PORT=9101

SECRET_KEY=change-me-local-dev-only
POSTGRES_USER=kemudi
POSTGRES_PASSWORD=kemudi
RABBITMQ_USER=kemudi
RABBITMQ_PASS=kemudi
RABBITMQ_ERLANG_COOKIE=change-me-local-dev-only

# Kemudi AI: Hermes (services/awak) talks to this OpenAI-compatible endpoint.
KEMUDI_AI_BASE_URL=https://ai.sumopod.com/v1
KEMUDI_AI_API_KEY=
KEMUDI_AI_MODEL=deepseek-flash

# Hermes API server (kemudi-hermes). Generate a key: openssl rand -hex 32
# In-compose URL below; from the host use http://127.0.0.1:8642/v1
KEMUDI_HERMES_API_KEY=
KEMUDI_HERMES_URL=http://kemudi-hermes:8642/v1

# Awak dev loop (docker compose --profile awak ...). See
# docs/superpowers/specs/2026-11-13-awak-dev-loop-design.md.
# Comma-separated project slugs the worker serves; empty = off.
KEMUDI_AWAK_PROJECTS=
# Passwords of the Taiga users "awak" (bot) and "awak-qa" (QA sandbox only).
KEMUDI_AWAK_PASSWORD=
KEMUDI_QA_PASSWORD=
# Keys that only guard kemudi-awak's and kemudi-runner's own ports:
# openssl rand -hex 32
KEMUDI_AWAK_API_KEY=
KEMUDI_RUNNER_KEY=
# Guards kemudi-svc, the only client of the sandboxed Docker daemon
# (kemudi-dind) that starts a project's compose services. Reachable only from
# the orchestrator; its own key, not the runner's: openssl rand -hex 32
KEMUDI_SVC_KEY=
KEMUDI_AWAK_MODEL=deepseek-flash
KEMUDI_QA_MODEL=deepseek-flash
# Awak reaches the model through the orchestrator's internal /llm/v1 proxy,
# which uses a project's or agent's own connection (BYOK, Project settings ->
# Agent) or KEMUDI_AI_BASE_URL / KEMUDI_AI_API_KEY above. This token only admits
# kemudi-awak to that proxy: openssl rand -hex 32
KEMUDI_LLM_PROXY_TOKEN=
# Kemudi instance admins: they manage Awak's skill library (project admins only
# assign enabled skills to roles). List Taiga user ids, comma-separated: sign in
# and open /api/kemudi/me for yours ("id"). KEMUDI_ADMIN_USERNAMES (Taiga
# usernames) is a fallback only: a user can change their own username to an
# admin's after the admin renames. Empty both = nobody manages the library.
KEMUDI_ADMIN_USER_IDS=
KEMUDI_ADMIN_USERNAMES=
# Encrypts the SSH deploy/machine keys Kemudi generates and BYOK model keys, at
# rest. Generate with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored keys unusable (regenerate them).
KEMUDI_SECRET_KEY=
