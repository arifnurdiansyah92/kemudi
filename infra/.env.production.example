# Kemudi production settings (infra/docker-compose.yml).
#
# Do not copy this by hand: run `sh scripts/init-secrets.sh`, which writes
# infra/.env from this file with every secret generated. Then edit the
# non-secret values below. Never commit infra/.env.
#
# Empty secrets are refused: compose will not start until each is set.

# --- Release ----------------------------------------------------------------
# Image tag of ghcr.io/arifnurdiansyah92/kemudi-*. Upgrades: docs/upgrade.md.
KEMUDI_VERSION=1.0.0

# --- Address ----------------------------------------------------------------
# What users type in the browser: host, plus :port when it is not 80/443.
KEMUDI_DOMAIN=kemudi.example.com
# https behind a TLS proxy (recommended); http only for a trial on localhost.
KEMUDI_SCHEME=https
# The gateway listens on KEMUDI_BIND:KEMUDI_HTTP_PORT. Keep 127.0.0.1 when a
# reverse proxy on the same host terminates TLS; 0.0.0.0 publishes it.
KEMUDI_BIND=127.0.0.1
KEMUDI_HTTP_PORT=8080
# Secure cookies (Django admin, CSRF). Set both to False only for plain http.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Anyone may sign up when True.
PUBLIC_REGISTER_ENABLED=False

# --- Database and queues (secrets generated) --------------------------------
POSTGRES_USER=kemudi
POSTGRES_PASSWORD=
RABBITMQ_USER=kemudi
RABBITMQ_PASS=
# Signs Taiga sessions, tokens and media URLs. Changing it logs everyone out.
SECRET_KEY=

# --- Mail (SMTP) ------------------------------------------------------------
# Invitations, password resets and notifications.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS on 587 (EMAIL_USE_TLS) or implicit TLS on 465 (EMAIL_USE_SSL).
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
# django.core.mail.backends.console.EmailBackend logs mail instead of sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Kemudi AI ----------------------------------------------------------------
# OpenAI-compatible provider for the contract baseline, CR check and backtests
# (--profile ai) and the default connection for Awak (--profile awak).
KEMUDI_AI_BASE_URL=https://ai.sumopod.com/v1
KEMUDI_AI_API_KEY=
KEMUDI_AI_MODEL=deepseek-flash
# Guards kemudi-hermes (generated).
KEMUDI_HERMES_API_KEY=
KEMUDI_HERMES_URL=http://kemudi-hermes:8642/v1
# Fernet key that encrypts generated SSH keys and BYOK model keys at rest
# (generated). KEEP A COPY with your backups: without it those keys are lost.
KEMUDI_SECRET_KEY=
# Kemudi instance admins (manage the skill library): Taiga user ids,
# comma-separated. Sign in and open /api/kemudi/me to see yours ("id").
KEMUDI_ADMIN_USER_IDS=
# Fallback by username; weaker (a user can rename to an admin's old name).
KEMUDI_ADMIN_USERNAMES=

# --- Awak (EXPERIMENTAL, --profile awak) -------------------------------------
# Read docs/install.md, "Awak (experimental)", first.
# Project slugs the worker serves; empty = worker off.
KEMUDI_AWAK_PROJECTS=
# Passwords of the Taiga users "awak" and "awak-qa" you create for it.
KEMUDI_AWAK_PASSWORD=
KEMUDI_QA_PASSWORD=
KEMUDI_AWAK_MODEL=deepseek-flash
KEMUDI_QA_MODEL=deepseek-flash
# Awak's loop: fix rounds inside one attempt (checks or review failed), a
# read-only review of the diff before QA, and the thinking level sent to the
# model on every call (none, low, medium, high, xhigh; empty sends nothing).
# KEMUDI_AWAK_FIX_ROUNDS=2
# KEMUDI_AWAK_REVIEW=true
# KEMUDI_AWAK_REASONING_EFFORT=high
# Internal service keys (generated; required even with the profile off).
KEMUDI_AWAK_API_KEY=
KEMUDI_RUNNER_KEY=
KEMUDI_SVC_KEY=
KEMUDI_LLM_PROXY_TOKEN=

# --- Model call logging (orchestrator) ---
# false: keep only hashes, token counts and cost of each model call (default).
# true: also keep full prompt and response text, which includes contract text.
KEMUDI_AI_LOG_PROMPTS=false
# Days to keep model call records; 0 keeps them indefinitely.
KEMUDI_AI_LOG_RETENTION_DAYS=90
