{
  "name": "playfast-us1",
  "networks": {
    "playfast": {
      "driver": "bridge",
      "name": "playfast-us1_playfast"
    }
  },
  "services": {
    "backend": {
      "build": {
        "context": "@CHECKOUT@",
        "dockerfile": "backend/Dockerfile"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "DATABASE_URL": "${DATABASE_URL:-postgresql://postgres:5432/playfast}",
        "DB_BACKUP_HOUR_WIB": "${DB_BACKUP_HOUR_WIB:-3}",
        "DB_BACKUP_RETENTION_DAILY_DAYS": "${DB_BACKUP_RETENTION_DAILY_DAYS:-14}",
        "DB_BACKUP_RETENTION_WEEKLY_DAYS": "${DB_BACKUP_RETENTION_WEEKLY_DAYS:-90}",
        "FLASK_ENV": "production",
        "FRONTEND_URL": "https://playfast.id",
        "GMAIL_OTP_APP_PASSWORD": "${GMAIL_OTP_APP_PASSWORD:-}",
        "GMAIL_OTP_EMAIL": "${GMAIL_OTP_EMAIL:-otp@example.com}",
        "GMAIL_OTP_IMAP_HOST": "${GMAIL_OTP_IMAP_HOST:-imap.gmail.com}",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID:-}",
        "INBOX_SSO_SECRET": "${INBOX_SSO_SECRET:-}",
        "INBOX_URL": "${INBOX_URL:-https://inbox.playfast.id}",
        "JWT_SECRET_KEY": "${JWT_SECRET_KEY:?JWT_SECRET_KEY must be set to a strong random value (openssl rand -hex 32)}",
        "MAIL_SENDER": "${MAIL_SENDER:-Playfast <noreply@playfast.id>}",
        "MIDTRANS_CLIENT_KEY": "${MIDTRANS_CLIENT_KEY:-}",
        "MIDTRANS_IS_PRODUCTION": "${MIDTRANS_IS_PRODUCTION:-false}",
        "MIDTRANS_SERVER_KEY": "${MIDTRANS_SERVER_KEY:-}",
        "OBJECT_STORAGE_ACCESS_KEY": "${OBJECT_STORAGE_ACCESS_KEY:-}",
        "OBJECT_STORAGE_SECRET_KEY": "${OBJECT_STORAGE_SECRET_KEY:-}",
        "PUSH_BATCH_SIZE": "${PUSH_BATCH_SIZE:-50}",
        "PUSH_MAX_CONCURRENCY": "${PUSH_MAX_CONCURRENCY:-4}",
        "RATELIMIT_STORAGE_URI": "${RATELIMIT_STORAGE_URI:-redis://redis:6379/0}",
        "SMTP_HOST": "${SMTP_HOST:-smtp-relay.brevo.com}",
        "SMTP_PASSWORD": "${SMTP_PASSWORD}",
        "SMTP_PORT": "${SMTP_PORT:-587}",
        "SMTP_USER": "${SMTP_USER}",
        "TURNSTILE_SECRET_KEY": "${TURNSTILE_SECRET_KEY:-}",
        "VAPID_PRIVATE_KEY": "${VAPID_PRIVATE_KEY:-}",
        "VAPID_SUBJECT": "${VAPID_SUBJECT:-mailto:support@playfast.id}"
      },
      "networks": {
        "playfast": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "5001",
          "target": 5000
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "uploads",
          "target": "/app/app/uploads",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "frontend": {
      "build": {
        "args": {
          "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "${NEXT_PUBLIC_GOOGLE_CLIENT_ID:-}",
          "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "${NEXT_PUBLIC_TURNSTILE_SITE_KEY:-}"
        },
        "context": "@CHECKOUT@",
        "dockerfile": "frontend/Dockerfile"
      },
      "depends_on": {
        "backend": {
          "condition": "service_started",
          "required": true
        }
      },
      "environment": {
        "INTERNAL_API_URL": "http://backend:5000",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "${NEXT_PUBLIC_GOOGLE_CLIENT_ID:-}",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "${NEXT_PUBLIC_TURNSTILE_SITE_KEY:-}",
        "NODE_ENV": "production"
      },
      "networks": {
        "playfast": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3001",
          "target": 3000
        }
      ],
      "restart": "unless-stopped"
    },
    "inbox-backend": {
      "build": {
        "context": "@CHECKOUT@/sales-inbox/backend",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "AGENT_SIGNATURE": "${INBOX_AGENT_SIGNATURE:-off}",
        "DATA_DIR": "/data",
        "FRONTEND_ORIGIN": "${INBOX_URL:-https://inbox.playfast.id}",
        "PLAYFAST_SSO_SECRET": "${INBOX_SSO_SECRET:?INBOX_SSO_SECRET must be set (openssl rand -hex 32); same value feeds backend INBOX_SSO_SECRET}",
        "POSTGRES_DSN": "${INBOX_DSN:-postgres://postgres:5432/sales_inbox}"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "50m"
        }
      },
      "networks": {
        "playfast": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8081",
          "target": 8080
        }
      ],
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "source": "inbox_media",
          "target": "/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "inbox-frontend": {
      "build": {
        "args": {
          "NEXT_PUBLIC_SSO_URL": "${INBOX_SSO_LAUNCHER:-https://playfast.id/admin/whatsapp}"
        },
        "context": "@CHECKOUT@/sales-inbox/frontend",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "inbox-backend": {
          "condition": "service_started",
          "required": true
        }
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "20m"
        }
      },
      "networks": {
        "playfast": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "3002",
          "target": 3000
        }
      ],
      "restart": "unless-stopped"
    },
    "postgres": {
      "environment": {
        "POSTGRES_DB": "playfast",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_USER": "playfast"
      },
      "healthcheck": {
        "interval": "5s",
        "retries": 5,
        "test": [
          "CMD-SHELL",
          "pg_isready -U playfast"
        ],
        "timeout": "3s"
      },
      "image": "postgres:17-alpine",
      "networks": {
        "playfast": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "type": "volume",
          "volume": {}
        }
      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--save",
        "",
        "--appendonly",
        "no"
      ],
      "healthcheck": {
        "interval": "5s",
        "retries": 5,
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "timeout": "3s"
      },
      "image": "redis:7-alpine",
      "networks": {
        "playfast": null
      },
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "inbox_media": {
      "name": "playfast-us1_inbox_media"
    },
    "pgdata": {
      "name": "playfast-us1_pgdata"
    },
    "uploads": {
      "name": "playfast-us1_uploads"
    }
  }
}
