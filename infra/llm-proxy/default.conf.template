# Kemudi: the only way the agents reach the model provider.
#
# Sits on the internal kemudi-sandbox network (agents) and the egress network.
# Adds the provider key so kemudi-awak never holds it, and forwards only the
# two endpoints Hermes needs. Rendered by the nginx image's envsubst at start.

server {
    listen 80;
    client_max_body_size 20m;

    location = /v1/chat/completions {
        proxy_pass ${KEMUDI_AI_BASE_URL}/chat/completions;
        proxy_set_header Authorization "Bearer ${KEMUDI_AI_API_KEY}";
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location = /v1/models {
        proxy_pass ${KEMUDI_AI_BASE_URL}/models;
        proxy_set_header Authorization "Bearer ${KEMUDI_AI_API_KEY}";
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    location / {
        return 403;
    }
}
